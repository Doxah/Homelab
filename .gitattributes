# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Fichiers SOPS et scripts : toujours en LF (un CR en fin de valeur casse les secrets)
*.sops.env text eol=lf
*.sops.yaml text eol=lf
*.sops.json text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# cmd.exe exige CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
