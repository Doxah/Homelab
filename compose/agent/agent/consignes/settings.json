{
  "$comment": "Permissions de Claude dans l'agent (claude -p --permission-mode dontAsk --setting-sources '' --settings ce-fichier). Tout ce qui n'est pas dans allow est refusé sans question ; deny l'emporte sur allow. Fichier dans l'image : Claude ne peut pas le modifier.",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(//data/depot/**)",
      "Write(//data/depot/**)",
      "WebSearch",
      "Bash(conteneurs)",
      "Bash(conteneur *)",
      "Bash(journaux *)",
      "Bash(evenements)",
      "Bash(evenements *)",
      "Bash(loki *)",
      "Bash(prom *)",
      "Bash(hote)",
      "Bash(action *)",
      "Bash(historique)",
      "Bash(historique *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(sleep *)",
      "Bash(date)"
    ],
    "deny": [
      "WebFetch",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(//home/agent/**)",
      "Read(//data/etat/**)",
      "Read(//actions/**)",
      "Edit(//data/depot/.git/**)",
      "Write(//data/depot/.git/**)",
      "Edit(//data/depot/.claude/**)",
      "Write(//data/depot/.claude/**)",
      "Edit(//data/depot/**/CLAUDE.md)",
      "Write(//data/depot/**/CLAUDE.md)",
      "Edit(//data/depot/.github/**)",
      "Write(//data/depot/.github/**)",
      "Edit(//data/depot/**/*.sops.*)",
      "Write(//data/depot/**/*.sops.*)",
      "Edit(//data/depot/.sops.yaml)",
      "Write(//data/depot/.sops.yaml)",
      "Edit(//data/depot/compose/agent/**)",
      "Write(//data/depot/compose/agent/**)",
      "Edit(//data/depot/compose/agent-actions.txt)",
      "Write(//data/depot/compose/agent-actions.txt)",
      "Edit(//data/depot/scripts/agent-actions.sh)",
      "Write(//data/depot/scripts/agent-actions.sh)"
    ]
  }
}
