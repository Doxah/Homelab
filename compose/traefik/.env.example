DOMAIN=<Domaine>
BIND_IP=<IP du serveur>
ACME_EMAIL=<adresse du compte Let's Encrypt (avis d'expiration)>
CF_DNS_API_TOKEN=<token API Cloudflare : Zone > DNS > Edit + Zone > Zone > Read, limité à la zone du domaine>
ADMIN_CIDRS=<Plage IP Admin>
DOCKER_GID=<sur le Serveur : getent group docker | cut -d: -f3>
